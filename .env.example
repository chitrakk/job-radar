# Copy to .env for local runs. In GitHub Actions these come from repository Secrets
# (Settings → Secrets and variables → Actions), never from a file.

# Adzuna — free signup at https://developer.adzuna.com (1000 calls/month).
# This is the main source of India-domestic listings, since it licenses Naukri/Indeed data.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# LLM enrichment (phase 2). Gemini is tried first, Groq is the fallback.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional residential proxy, e.g. http://user:pass@host:port
# Without it the Tier 2 scrapers (Naukri, Indeed India) report as blocked from cloud IPs.
JOBRADAR_PROXY_URL=
